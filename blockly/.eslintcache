[{"C:\\Dharun\\SEM6\\Software_E\\Project\\blockly\\src\\index.js":"1","C:\\Dharun\\SEM6\\Software_E\\Project\\blockly\\src\\reportWebVitals.js":"2","C:\\Dharun\\SEM6\\Software_E\\Project\\blockly\\src\\App.js":"3","C:\\Dharun\\SEM6\\Software_E\\Project\\blockly\\src\\customBlocks\\custom_Blocks.js":"4","C:\\Dharun\\SEM6\\Software_E\\Project\\Interactive-Learning-App-for-Kids\\blockly\\src\\index.js":"5","C:\\Dharun\\SEM6\\Software_E\\Project\\Interactive-Learning-App-for-Kids\\blockly\\src\\App.js":"6","C:\\Dharun\\SEM6\\Software_E\\Project\\Interactive-Learning-App-for-Kids\\blockly\\src\\reportWebVitals.js":"7","C:\\Dharun\\SEM6\\Software_E\\Project\\Interactive-Learning-App-for-Kids\\blockly\\src\\customBlocks\\custom_Blocks.js":"8"},{"size":517,"mtime":1743926508125,"results":"9","hashOfConfig":"10"},{"size":375,"mtime":1743926508127,"results":"11","hashOfConfig":"10"},{"size":8201,"mtime":1743926508119,"results":"12","hashOfConfig":"10"},{"size":5992,"mtime":1743926508122,"results":"13","hashOfConfig":"10"},{"size":517,"mtime":1743926508125,"results":"14","hashOfConfig":"15"},{"size":8201,"mtime":1743926508119,"results":"16","hashOfConfig":"15"},{"size":375,"mtime":1743926508127,"results":"17","hashOfConfig":"15"},{"size":5992,"mtime":1743926508122,"results":"18","hashOfConfig":"15"},{"filePath":"19","messages":"20","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"158igd3",{"filePath":"21","messages":"22","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"23","messages":"24","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"25","messages":"26","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"27","messages":"28","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"mrcnjq",{"filePath":"29","messages":"30","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"31"},{"filePath":"32","messages":"33","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"34","messages":"35","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"C:\\Dharun\\SEM6\\Software_E\\Project\\blockly\\src\\index.js",[],"C:\\Dharun\\SEM6\\Software_E\\Project\\blockly\\src\\reportWebVitals.js",[],"C:\\Dharun\\SEM6\\Software_E\\Project\\blockly\\src\\App.js",["36","37"],"C:\\Dharun\\SEM6\\Software_E\\Project\\blockly\\src\\customBlocks\\custom_Blocks.js",[],"C:\\Dharun\\SEM6\\Software_E\\Project\\Interactive-Learning-App-for-Kids\\blockly\\src\\index.js",[],"C:\\Dharun\\SEM6\\Software_E\\Project\\Interactive-Learning-App-for-Kids\\blockly\\src\\App.js",["38","39"],"\r\n\r\nimport \"./App.css\";\r\nimport \"./customBlocks/custom_Blocks\";\r\nimport React from \"react\";\r\nimport ReactBlockly from \"react-blockly\";\r\nimport Blockly from \"blockly\";\r\n\r\nexport default function App() {\r\n  const randomTasks = [\r\n    {\r\n      id: \"say_hello\",\r\n      description: \"Print the word Hello\",\r\n      xml: `<xml xmlns=\"http://www.w3.org/1999/xhtml\">\r\n        <block type=\"text_print\" x=\"70\" y=\"30\">\r\n          <value name=\"TEXT\">\r\n            <shadow type=\"text\">\r\n              <field name=\"TEXT\">Hello</field>\r\n            </shadow>\r\n          </value>\r\n        </block>\r\n      </xml>`,\r\n      expectedOutput: \"Hello \"\r\n    },\r\n    {\r\n      id: \"count_to_3\",\r\n      description: \"Print the numbers 1 to 3\",\r\n      xml: `<xml xmlns=\"http://www.w3.org/1999/xhtml\">\r\n        <block type=\"controls_repeat_ext\" x=\"70\" y=\"30\">\r\n          <value name=\"TIMES\">\r\n            <shadow type=\"math_number\">\r\n              <field name=\"NUM\">3</field>\r\n            </shadow>\r\n          </value>\r\n          <statement name=\"DO\">\r\n            <block type=\"text_print\">\r\n              <value name=\"TEXT\">\r\n                <shadow type=\"math_number\">\r\n                  <field name=\"NUM\">1</field>\r\n                </shadow>\r\n              </value>\r\n            </block>\r\n          </statement>\r\n        </block>\r\n      </xml>`,\r\n      expectedOutput: \"1 1 1 \"\r\n    },\r\n    {\r\n      id: \"add_numbers\",\r\n      description: \"Print the sum of 5 + 2\",\r\n      xml: `<xml xmlns=\"http://www.w3.org/1999/xhtml\">\r\n        <block type=\"text_print\" x=\"70\" y=\"30\">\r\n          <value name=\"TEXT\">\r\n            <block type=\"math_arithmetic\">\r\n              <field name=\"OP\">ADD</field>\r\n              <value name=\"A\">\r\n                <shadow type=\"math_number\">\r\n                  <field name=\"NUM\">5</field>\r\n                </shadow>\r\n              </value>\r\n              <value name=\"B\">\r\n                <shadow type=\"math_number\">\r\n                  <field name=\"NUM\">2</field>\r\n                </shadow>\r\n              </value>\r\n            </block>\r\n          </value>\r\n        </block>\r\n      </xml>`,\r\n      expectedOutput: \"7 \"\r\n    }\r\n  ];\r\n\r\n  const [currentTask, setCurrentTask] = React.useState(null);\r\n\r\n  \r\n  const initialXml =\r\n    <xml xmlns=\"http://www.w3.org/1999/xhtml\"><block type=\"text\" x=\"70\" y=\"30\"><field name=\"TEXT\"></field></block></xml>;\r\n    const toolboxCategories = [\r\n      {\r\n        name: \"Custom\",\r\n        colour: \"#5CA699\",\r\n        blocks: [\r\n          { type: \"stringOf\" },\r\n          { type: \"responceontext\" },\r\n          { type: \"simplebot\" },\r\n          { type: \"regexInput\" },\r\n        ],\r\n      },\r\n      {\r\n        name: \"Control\",\r\n        colour: \"#FFAB19\",\r\n        blocks: [\r\n          { type: \"controls_if\" },\r\n          { type: \"controls_repeat\" },\r\n          { type: \"controls_whileUntil\" },\r\n          { type: \"say\" },\r\n          { type: \"wait\" },\r\n          { type: \"repeat\" },\r\n          { type: \"forever\" },\r\n          { type: \"if\" },\r\n          { type: \"if_else\" },\r\n          { type: \"wait_until\" },\r\n          { type: \"repeat_until\" },\r\n        ],\r\n      },\r\n      {\r\n        name: \"Logic\",\r\n        colour: \"#5C81A6\",\r\n        blocks: [\r\n          { type: \"logic_compare\" },\r\n          { type: \"logic_operation\" },\r\n          { type: \"logic_boolean\" },\r\n        ],\r\n      },\r\n      {\r\n        name: \"Math\",\r\n        colour: \"#5CA65C\",\r\n        blocks: [\r\n          { type: \"math_number\" },\r\n          { type: \"math_arithmetic\" },\r\n          { type: \"math_round\" },\r\n        ],\r\n      },\r\n      {\r\n        name: \"Text\",\r\n        colour: \"#5CA699\",\r\n        blocks: [\r\n          { type: \"text\" },\r\n          { type: \"text_print\" },\r\n        ],\r\n      },\r\n    ];\r\n\r\n\r\n    Blockly.JavaScript['text_print'] = function(block) {\r\n      var argument0 = Blockly.JavaScript.valueToCode(block, 'TEXT',\r\n          Blockly.JavaScript.ORDER_NONE) || '\"\"';\r\n      return 'console.log(' + argument0 + ');\\n';\r\n    };\r\n    \r\n\r\n  function workspaceDidChange(workspace) {\r\n    const newXml = Blockly.Xml.domToText(Blockly.Xml.workspaceToDom(workspace));\r\n    document.getElementById(\"generated-xml\").innerText = \"\";\r\n\r\n    const code = Blockly.JavaScript.workspaceToCode(workspace);\r\n    document.getElementById(\"code\").value = code;\r\n  }\r\n\r\n\r\n  function runCode() {\r\n  console.log(\"Executing Blockly Code...\");\r\n  document.getElementById(\"output\").innerText = \"\";\r\n\r\n  const code = document.getElementById(\"code\").value;\r\n  window.LoopTrap = 1000;\r\n\r\n  let outputText = \"\";\r\n\r\n  const originalLog = console.log;\r\n  console.log = function (message) {\r\n    outputText += message + \" \";\r\n    originalLog.apply(console, arguments);\r\n  };\r\n\r\n  try {\r\n    eval(code);\r\n  } catch (e) {\r\n    outputText = \"Error: \" + e;\r\n  }\r\n\r\n  console.log = originalLog;\r\n  document.getElementById(\"output\").innerText = outputText;\r\n\r\n  if (currentTask) {\r\n    const expected = currentTask.expectedOutput.trim();\r\n    const actual = outputText.trim();\r\n    const resultText =\r\n      expected === actual\r\n        ? \"✅ Correct Output!\"\r\n        : `❌ Try Again. Expected: \"${expected}\", but got \"${actual}\"`;\r\n    document.getElementById(\"task-result\").innerText = resultText;\r\n  }\r\n}\r\n\r\nconst [showSolution, setShowSolution] = React.useState(false);\r\n\r\nreturn (\r\n  <>\r\n    <div id=\"task-desc\" style={{ marginTop: \"10px\", fontWeight: \"bold\" }}></div>\r\n    <div id=\"task-result\" style={{ marginTop: \"5px\" }}></div>\r\n\r\n    <ReactBlockly\r\n      toolboxCategories={toolboxCategories}\r\n      initialXml={initialXml}\r\n      wrapperDivClassName=\"fill-height\"\r\n      workspaceConfiguration={{\r\n        grid: {\r\n          spacing: 20,\r\n          length: 3,\r\n          colour: \"#ccc\",\r\n          snap: true,\r\n        },\r\n      }}\r\n      workspaceDidChange={workspaceDidChange}\r\n    />\r\n\r\n    <div\r\n      style={{\r\n        display: \"flex\",\r\n        justifyContent: \"center\",\r\n        gap: \"20px\",\r\n        marginTop: \"30px\",\r\n        flexWrap: \"wrap\",\r\n      }}\r\n    >\r\n      <button\r\n        onClick={runCode}\r\n        style={buttonStyle(\"#4CAF50\", \"#45a049\")}\r\n      >\r\n        ▶️ Run\r\n      </button>\r\n\r\n      <button\r\n        onClick={() => {\r\n          const task = randomTasks[Math.floor(Math.random() * randomTasks.length)];\r\n          setCurrentTask(task);\r\n          setShowSolution(false); // hide solution blocks initially\r\n          const workspace = Blockly.getMainWorkspace();\r\n          workspace.clear(); // clear old blocks\r\n          document.getElementById(\"task-desc\").innerText = \"🧠 Task: \" + task.description;\r\n          document.getElementById(\"task-result\").innerText = \"\";\r\n        }}\r\n        style={buttonStyle(\"#2196F3\", \"#1976D2\")}\r\n      >\r\n        🎲 New Task\r\n      </button>\r\n\r\n      <button\r\n        onClick={() => {\r\n          if (currentTask && !showSolution) {\r\n            const workspace = Blockly.getMainWorkspace();\r\n            workspace.clear();\r\n            Blockly.Xml.domToWorkspace(\r\n              Blockly.Xml.textToDom(currentTask.xml),\r\n              workspace\r\n            );\r\n            setShowSolution(true);\r\n          }\r\n        }}\r\n        style={buttonStyle(\"#FF9800\", \"#F57C00\")}\r\n        disabled={!currentTask || showSolution}\r\n      >\r\n        💡 View Solution\r\n      </button>\r\n    </div>\r\n\r\n    <pre id=\"generated-xml\"></pre>\r\n\r\n    <textarea\r\n      id=\"code\"\r\n      style={{ height: \"200px\", width: \"400px\", display: \"none\" }}\r\n      value=\"\"\r\n      readOnly\r\n    ></textarea>\r\n\r\n    <div\r\n      id=\"output\"\r\n      style={{\r\n        border: \"1px solid black\",\r\n        padding: \"10px\",\r\n        marginTop: \"10px\",\r\n        minHeight: \"50px\",\r\n        background: \"#f5f5f5\"\r\n      }}\r\n    >\r\n      <b>Output:</b>\r\n    </div>\r\n  </>\r\n);\r\n\r\nfunction buttonStyle(baseColor, hoverColor) {\r\n  return {\r\n    backgroundColor: baseColor,\r\n    color: \"white\",\r\n    padding: \"12px 24px\",\r\n    border: \"none\",\r\n    borderRadius: \"8px\",\r\n    cursor: \"pointer\",\r\n    fontSize: \"16px\",\r\n    fontWeight: \"bold\",\r\n    transition: \"background-color 0.3s\",\r\n    ...(hoverColor && {\r\n      onMouseOver: (e) => (e.target.style.backgroundColor = hoverColor),\r\n      onMouseOut: (e) => (e.target.style.backgroundColor = baseColor),\r\n    }),\r\n  };\r\n}\r\n\r\n\r\n}\r\n","C:\\Dharun\\SEM6\\Software_E\\Project\\Interactive-Learning-App-for-Kids\\blockly\\src\\reportWebVitals.js",[],"C:\\Dharun\\SEM6\\Software_E\\Project\\Interactive-Learning-App-for-Kids\\blockly\\src\\customBlocks\\custom_Blocks.js",[],{"ruleId":"40","severity":1,"message":"41","line":144,"column":11,"nodeType":"42","messageId":"43","endLine":144,"endColumn":17},{"ruleId":"44","severity":1,"message":"45","line":168,"column":5,"nodeType":"46","messageId":"47","endLine":168,"endColumn":9},{"ruleId":"40","severity":1,"message":"41","line":144,"column":11,"nodeType":"42","messageId":"43","endLine":144,"endColumn":17},{"ruleId":"44","severity":1,"message":"45","line":168,"column":5,"nodeType":"46","messageId":"47","endLine":168,"endColumn":9},"no-unused-vars","'newXml' is assigned a value but never used.","Identifier","unusedVar","no-eval","eval can be harmful.","CallExpression","unexpected"]